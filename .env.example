# Variables de entorno para las Netlify Functions.
# Para desarrollo local con `netlify dev`, copiá este archivo a `.env` y llenalo.
# Para producción, configurá estas variables en Netlify UI:
#   Site settings → Environment variables.

# API key de Anthropic (Claude). Necesaria para la function /parse-order.
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Proyecto de Firebase usado para verificar los tokens de auth en
# netlify/functions/_shared/firebaseAuth.js. Opcional: si no se define,
# usa 'rutawater'. Solo hay que setearla si el proyecto Firebase cambia.
FIREBASE_PROJECT_ID=rutawater

# Credencial de la cuenta de servicio dedicada para promociones, el contador
# autoritativo de Pedido IA y la eliminación segura de cuentas. Debe tener los
# roles mínimos Datastore User y Firebase Authentication Admin.
# Guardar el JSON completo codificado en base64. Nunca versionar el valor real.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Secreto de operador (mínimo 32 caracteres) para la migración reanudable de
# scopeKey. No se incluye en la app ni se comparte con usuarios finales.
DATA_SCOPE_MIGRATION_TOKEN=

# Build mínimo compatible configurado únicamente en el backend. El endpoint de
# migración ignora cualquier build enviado en el body y mantiene el sellado
# cerrado si este valor falta.
DATA_SCOPE_MINIMUM_APP_BUILD=

# Segunda prueba de operador, aleatoria y de al menos 32 caracteres. Se compara
# en tiempo constante al sellar escrituras y al activar el gate global de
# lecturas. Nunca incluir este valor en la app ni en Git.
DATA_SCOPE_MINIMUM_VERSION_PROOF=

# Opcionales: claves PUBLICAS de RevenueCat usadas para leer el plan desde el
# backend. Si quedan vacías se usan las mismas public keys incluidas en la app.
# No usar una secret key de RevenueCat para esta consulta de solo lectura.
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# Secreto aleatorio de al menos 32 caracteres usado para calcular el HMAC de
# los códigos. Debe ser el mismo al crear códigos y al ejecutar la Function.
PROMO_CODE_PEPPER=
